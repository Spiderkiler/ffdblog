---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "../components/control/Pagination.astro";
import HomeHero from "../components/HomeHero.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const isFirstPage = page.currentPage === 1;
---

<MainGridLayout>
    {isFirstPage && <HomeHero />}

    <div class="onload-animation flex items-end justify-between gap-4 mb-5">
        <div>
            {isFirstPage ? (
                <>
                    <h2 class="text-xl md:text-2xl font-bold tracking-tight text-90">最近更新</h2>
                    <p class="mt-1.5 text-sm text-50">技术记录与生活片段，按时间倒序排列。</p>
                </>
            ) : (
                <>
                    <h1 class="text-xl md:text-2xl font-bold tracking-tight text-90">文章 · 第 {page.currentPage} 页</h1>
                    <p class="mt-1.5 text-sm text-50">继续往下翻，或者回到首页。</p>
                </>
            )}
        </div>
        <a href={url("/archive/")}
           class="shrink-0 inline-flex items-center gap-1 text-sm font-medium text-50 transition hover:text-[var(--primary)]">
            全部文章
            <Icon name="material-symbols:arrow-forward-rounded" class="text-[1.1rem]"></Icon>
        </a>
    </div>

    <PostPage page={page}></PostPage>
    {page.lastPage > 1 && (
        <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
    )}
</MainGridLayout>
