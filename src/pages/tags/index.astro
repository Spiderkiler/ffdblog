---
import TaxonomyIndex from "@components/TaxonomyIndex.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagList } from "@utils/content-utils";
import { getTagUrl } from "@utils/url-utils";

const tags = await getTagList();
const items = tags.map((t) => ({
	name: t.name.trim(),
	count: t.count,
	url: getTagUrl(t.name),
}));
---

<MainGridLayout title="标签" description="按标签浏览全部文章">
    <TaxonomyIndex
            title="标签"
            description={`共 ${items.length} 个标签，按兴趣挑一个看看吧。`}
            items={items}
    />
</MainGridLayout>
