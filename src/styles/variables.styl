/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms
  --card-border: unquote("oklch(0.925 0.012 var(--hue) / 0.8)")
  --card-shadow: unquote("0 1px 2px rgba(35, 25, 35, 0.035), 0 18px 40px -30px oklch(0.62 0.16 var(--hue) / 0.42)")
  --card-shadow-hover: unquote("0 2px 6px rgba(35, 25, 35, 0.05), 0 26px 52px -28px oklch(0.62 0.16 var(--hue) / 0.55)")
  --btn-shadow: unquote("0 8px 18px -12px oklch(0.62 0.16 var(--hue) / 0.55)")
  --brand-gradient: unquote("linear-gradient(135deg, oklch(0.97 0.025 var(--hue)), oklch(0.91 0.06 var(--hue)))")
  --brand-border: unquote("oklch(0.87 0.07 var(--hue) / 0.9)")
  --brand-text: oklch(0.46 0.14 var(--hue))
  --nav-bg: unquote("oklch(1 0 0 / 0.86)")

:root.dark
  --card-border: oklch(0.30 0.02 var(--hue))
  --card-shadow: unquote("0 1px 2px rgba(0, 0, 0, 0.35), 0 20px 44px -30px oklch(0.62 0.16 var(--hue) / 0.5)")
  --card-shadow-hover: unquote("0 2px 6px rgba(0, 0, 0, 0.4), 0 28px 56px -30px oklch(0.62 0.16 var(--hue) / 0.65)")
  --btn-shadow: unquote("0 8px 20px -12px oklch(0.62 0.16 var(--hue) / 0.5)")
  --brand-gradient: unquote("linear-gradient(135deg, oklch(0.40 0.08 var(--hue)), oklch(0.32 0.06 var(--hue)))")
  --brand-border: oklch(0.46 0.09 var(--hue))
  --brand-text: oklch(0.88 0.06 var(--hue))
  --nav-bg: unquote("oklch(0.205 0.014 var(--hue) / 0.86)")

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.62 0.16 var(--hue)) oklch(0.78 0.11 var(--hue))
  --primary-soft: oklch(0.95 0.035 var(--hue)) oklch(0.30 0.04 var(--hue))
  --page-bg: oklch(0.985 0.004 var(--hue)) oklch(0.155 0.012 var(--hue))
  --card-bg: white oklch(0.205 0.014 var(--hue))

  --btn-content: oklch(0.48 0.13 var(--hue)) oklch(0.82 0.09 var(--hue))

  --btn-regular-bg: oklch(0.965 0.022 var(--hue)) oklch(0.28 0.03 var(--hue))
  --btn-regular-bg-hover: oklch(0.94 0.04 var(--hue)) oklch(0.33 0.04 var(--hue))
  --btn-regular-bg-active: oklch(0.91 0.055 var(--hue)) oklch(0.37 0.045 var(--hue))

  --btn-plain-bg-hover: oklch(0.96 0.02 var(--hue)) oklch(0.27 0.03 var(--hue))
  --btn-plain-bg-active: oklch(0.93 0.035 var(--hue)) oklch(0.24 0.025 var(--hue))

  --btn-card-bg-hover: oklch(0.975 0.012 var(--hue)) oklch(0.27 0.03 var(--hue))
  --btn-card-bg-active: oklch(0.945 0.03 var(--hue)) oklch(0.32 0.035 var(--hue))

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.28 0.02 var(--hue))

  --title-active: oklch(0.50 0.13 var(--hue))

  --line-divider: black(0.07) white(0.08)

  --line-color: black(0.09) white(0.1)
  --meta-divider: black(0.18) white(0.2)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.90 0.06 var(--hue)) oklch(0.40 0.09 var(--hue))
  --codeblock-selection: oklch(0.40 0.08 var(--hue))
  --codeblock-bg: oklch(0.17 0.015 var(--hue)) oklch(0.17 0.015 var(--hue))
  --codeblock-topbar-bg: oklch(0.3 0.02 var(--hue)) oklch(0.12 0.015 var(--hue))

  --license-block-bg: black(0.025) var(--codeblock-bg)

  --link-underline: oklch(0.88 0.06 var(--hue)) oklch(0.40 0.08 var(--hue))
  --link-hover: oklch(0.94 0.04 var(--hue)) oklch(0.40 0.08 var(--hue))
  --link-active: oklch(0.89 0.055 var(--hue)) oklch(0.35 0.07 var(--hue))

  --float-panel-bg: white oklch(0.19 0.015 var(--hue))

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: oklch(0.92 0.045 var(--hue)) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.955 0.02 var(--hue)) oklch(0.22 0.02 var(--hue))
  --toc-btn-active: oklch(0.93 0.03 var(--hue)) oklch(0.25 0.02 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.62 0.15 var(--hue)) oklch(0.35 0.07 var(--hue))
})
